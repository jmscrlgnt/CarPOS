    </PropertyGroup>
    <Error Condition="!Exists('$(NativeSQLiteSource)')" Text="Native SQLite runtime e_sqlite3.dll was not found. Restore NuGet packages and rebuild the solution." />
    <Copy SourceFiles="$(NativeSQLiteSource)" DestinationFiles="$(TargetDir)e_sqlite3.dll" SkipUnchangedFiles="true" />
  </Target>
